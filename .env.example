# Copy this file to .env and fill in real values - .env is gitignored.
# Loaded automatically by playwright.sites.config.ts (via dotenv), so this is the ONE place
# to change a site's URL/credentials instead of editing each sites/<site>/test_data/config.json.
#
# Each site only reads its own *_URL/*_EMAIL/*_PASSWORD (picked by --project=<site>), so unused
# sites don't interfere - comment out (#) any block you're not testing, purely for tidiness.

# Global defaults (used if site-specific vars not set)
BASE_URL=http://localhost:3000
TEST_EMAIL=user@example.com
TEST_PASSWORD=password123

# NUH site
NUH_URL=https://cortex-nuh-new.cortexcloud.co
NUH_EMAIL=nuh_user@example.com
NUH_PASSWORD=nuh_password123

# TMH site
TMH_URL=http://localhost:3001
TMH_EMAIL=tmh_user@example.com
TMH_PASSWORD=tmh_password123

# SBH site
SBH_URL=https://cortex-sbh-new.cortexcloud.co
SBH_EMAIL=sbh_user@example.com
SBH_PASSWORD=sbh_password123
